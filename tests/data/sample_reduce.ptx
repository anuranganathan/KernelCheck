//
// HAND-WRITTEN SAMPLE for KernelCheck unit tests. It imitates the layout of
// `nvcc -ptx` output for a shared-memory reduction (shared memory, a loop,
// barriers and an atomic) but was NOT produced by a compiler, and is
// simplified: it is a parser fixture, not a semantically complete kernel.
//

.version 8.4
.target sm_52
.address_size 64

.visible .entry _Z13reduce_kernelPKiPii(
	.param .u64 _Z13reduce_kernelPKiPii_param_0,
	.param .u64 _Z13reduce_kernelPKiPii_param_1,
	.param .u32 _Z13reduce_kernelPKiPii_param_2
)
{
	.reg .pred 	%p<4>;
	.reg .b32 	%r<16>;
	.reg .b64 	%rd<5>;
	// demoted variable
	.shared .align 4 .b8 _ZZ13reduce_kernelPKiPiiE7partial[1024];

	ld.param.u64 	%rd1, [_Z13reduce_kernelPKiPii_param_0];
	ld.param.u32 	%r3, [_Z13reduce_kernelPKiPii_param_2];
	mov.u32 	%r1, %tid.x;
	mov.u32 	%r4, _ZZ13reduce_kernelPKiPiiE7partial;
	shl.b32 	%r5, %r1, 2;
	add.s32 	%r2, %r4, %r5;
	st.shared.u32 	[%r2], %r3;
	bar.sync 	0;
	mov.u32 	%r15, 128;

$L__BB0_1:
	setp.ge.u32 	%p2, %r1, %r15;
	@%p2 bra 	$L__BB0_3;
	ld.shared.u32 	%r8, [%r2];
	add.s32 	%r9, %r8, %r15;
	st.shared.u32 	[%r2], %r9;

$L__BB0_3:
	bar.sync 	0;
	shr.u32 	%r15, %r15, 1;
	setp.ne.s32 	%p3, %r15, 0;
	@%p3 bra 	$L__BB0_1;

	setp.ne.s32 	%p1, %r1, 0;
	@%p1 bra 	$L__BB0_6;
	ld.shared.u32 	%r12, [_ZZ13reduce_kernelPKiPiiE7partial];
	cvta.to.global.u64 	%rd2, %rd1;
	atom.global.add.u32 	%r13, [%rd2], %r12;

$L__BB0_6:
	ret;

}
